# =============================================================
# FILE MẪU CHO BIẾN MÔI TRƯỜNG (SECRETS)
# =============================================================
# HƯỚNG DẪN:
#   1. Copy file này thành file mới tên ".env" (bỏ đuôi .example)
#      Lệnh PowerShell:  Copy-Item .env.example .env
#   2. Điền giá trị thật của bạn vào file ".env"
#   3. KHÔNG BAO GIỜ commit file ".env" lên Git (đã có trong .gitignore)
#
# Vì sao phải làm vậy?
#   File .env.example chỉ là "mẫu" — an toàn để đưa lên GitHub vì
#   không chứa giá trị thật. File .env chứa chìa khoá thật, tuyệt đối
#   không được để lộ, nếu không ai đó có thể dùng tài khoản AWS/DB của bạn
#   và bạn có thể bị tính phí hoặc bị đánh cắp dữ liệu.
# =============================================================

# --- AWS credentials (lấy từ IAM User bạn tạo ở Phase 3) ---
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=ap-southeast-1

# --- Tên bucket S3 dùng làm Data Lake ---
# Tên bucket S3 phải DUY NHẤT toàn cầu, ví dụ: ecommerce-pipeline-yourname-2026
S3_BUCKET_NAME=your-bucket-name-here

# --- Thông tin kết nối PostgreSQL (local hoặc cloud) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_analytics
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# --- (Tuỳ chọn) Slack Webhook để nhận thông báo sau mỗi lần chạy pipeline ---
# Để trống (không điền gì) = tắt tính năng này, pipeline vẫn chạy bình thường.
# Cách tạo: vào https://api.slack.com/apps -> Create New App -> From scratch
#   -> chọn workspace -> Incoming Webhooks -> Activate -> Add New Webhook to Workspace
#   -> chọn kênh -> copy URL dạng https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_WEBHOOK_URL=
